# Porta do servidor (padrão 3002, para não conflitar com o portal B2B em 3000 e o admin B2B em 3001)
PORT=3002

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=compras_pull

# Segredo usado para assinar o token de sessão (troque em produção)
SESSION_SECRET=troque-este-segredo

# SMTP para "Efetuar Compra Fornecedor" e "Notificar associados".
# Sem SMTP_HOST os envios são registrados como "simulado" (útil para testes).
# Mesmos nomes do meuConsultorioWeb. Porta 465 usa conexão segura (SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Vercel Blob: anexos dos pedidos, gravados na pasta "comprasweb/" do store.
# Sem token, os anexos ficam na pasta local uploads/.
BLOB_READ_WRITE_TOKEN=

# Google Imagens via Serper: "Buscar imagens dos produtos" (https://serper.dev)
SERPER_API_KEY=
